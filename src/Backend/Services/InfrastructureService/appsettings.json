{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PlacesProvider": {
    "Provider": "Overpass"
  },
  "Geoapify": {
    "BaseUrl": "https://api.geoapify.com/",
    "ApiKey": "eb907a492dd24e878a97c97e56bb289c",
    "TimeoutSeconds": 10,
    "Language": "ru"
  },
  "Overpass": {
    "BaseUrl": "https://overpass-api.de/api/interpreter",
    "FallbackBaseUrls": [
      "https://overpass.kumi.systems/api/interpreter",
      "https://overpass.osm.ch/api/interpreter",
      "https://maps.mail.ru/osm/tools/overpass/api/interpreter"
    ],
    "TimeoutSeconds": 8,
    "DefaultRadiusMeters": 1200,
    "MaxRadiusMeters": 15000,
    "UsePublicInstance": true,
    "RetryCount": 0,
    "RetryDelayMs": 500,
    "UserAgent": "DiplomaRealEstateApp/1.0"
  },
  "InfrastructureScoring": {
    "DefaultRadiusMeters": 1200,
    "MaxRadiusMeters": 15000,
    "MaxPoiCount": 5000,
    "CacheMinutes": 30
  },
  "RouteMetrics": {
    "Provider": "Osrm",
    "WalkSpeedKmPerHour": 4.8,
    "DriveSpeedKmPerHour": 28.0
  },
  "Osrm": {
    "BaseUrl": "http://localhost:5000",
    "FootBaseUrl": "http://localhost:5000",
    "CarBaseUrl": "http://localhost:5001",
    "FootProfile": "foot",
    "CarProfile": "driving",
    "RequestTimeoutSeconds": 8
  },
  "Yandex": {
    "GeocoderBaseUrl": "https://geocode-maps.yandex.ru/",
    "Language": "ru_RU",
    "ApiKey": ""
  }
}
