{
  "openapi": "3.1.1",
  "info": {
    "title": "UserService | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5191/"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "UserService"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/info/{email}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Gets user information by email.",
        "description": "Requires an authenticated user and passes the owner-or-admin access filter before returning the profile data.",
        "operationId": "GetUserInfoByEmail",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/info": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Gets the current authenticated user's profile.",
        "description": "Returns the profile of the user identified by the access token.",
        "operationId": "GetCurrentUserInfo",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/signup": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Registers a new local user.",
        "description": "Creates a user with email and password authentication.",
        "operationId": "SignUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpUserDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/signin": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Signs in a local user.",
        "description": "Validates credentials and returns an access token with a refresh token.",
        "operationId": "SignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInUserDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/google/result": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Completes Google sign-up.",
        "description": "Consumes the external authentication result and creates a user from Google profile data.",
        "operationId": "GoogleSignUpResult",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/google/signin": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Signs in through Google.",
        "description": "Uses the authenticated Google external session and returns local JWT tokens.",
        "operationId": "GoogleSignIn",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/refresh-token": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Refreshes an expired access token.",
        "description": "Accepts a refresh token and returns a new access token with a rotated refresh token.",
        "operationId": "RefreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/change-password": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Changes the current user's password.",
        "description": "Requires authentication and validates the current password before applying the new password.",
        "operationId": "ChangePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordDto": {
        "required": [
          "email",
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "RefreshTokenRequestDto": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "SignInUserDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SignUpUserDto": {
        "required": [
          "name",
          "email",
          "password",
          "accountImageUrl"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "accountImageUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "UserService"
    },
    {
      "name": "Users"
    }
  ]
}